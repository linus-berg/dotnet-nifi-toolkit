<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        
        <!-- NuGet Metadata -->
        <PackageId>Nifi.Utils</PackageId>
        <Authors>linus-berg</Authors>
        <Description>A lightweight .NET library for producing, receiving, and transporting Apache NiFi FlowFiles (V1, V3, and S2S).</Description>
        <PackageTags>nifi;flowfile;s2s;transport;utils</PackageTags>
        <RepositoryUrl>https://github.com/linus-berg/dotnet-nifi-utils</RepositoryUrl>
        <PackageProjectUrl>https://github.com/linus-berg/dotnet-nifi-utils</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    </PropertyGroup>

</Project>
